# Copia este archivo como .env y rellena los valores de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FB_DATABASE_URL=https://tu-proyecto-default-rtdb.europe-west1.firebasedatabase.app
VITE_FB_PROJECT_ID=tu-proyecto
VITE_FB_APP_ID=
# Dirección donde se publica la versión web (Firebase Hosting)
VITE_WEB_URL=https://tu-proyecto.web.app
